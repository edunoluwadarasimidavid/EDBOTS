# =====================================================================
#                EDBOTS — Environment Variables Template
#
#  Setup: copy this file to a local env file and fill in your values.
#
#  NEVER put real API keys, tokens, passwords, or WhatsApp credentials
#  in any file you commit.
# =====================================================================

# ---------------------------------------------------------------------
# Bot identity & runtime
# ---------------------------------------------------------------------

# Bot display name (also used as sticker pack name).
BOT_NAME=EDBOTS

# Session folder name for WhatsApp auth state.
SESSION_NAME=session

# Comma-separated list of owner WhatsApp numbers (international format,
# digits only). These users get owner-only commands. Example:
#   OWNER_NUMBER=2348012345678,2349098765432
OWNER_NUMBER=

# Strong random string used to encrypt session files locally.
# If it changes, the current session becomes invalid and needs re-pairing.
BOT_SECRET=

# Session ID for headless deployments (optional alternative to QR pairing).
SESSION_ID=

# Optional master Puter token (usually captured via the .puter link flow).
PUTER_TOKEN=

# ---------------------------------------------------------------------
# AI providers (optional — bot works without them using free fallbacks)
# ---------------------------------------------------------------------

GROQ_API_KEY=
SAMBANOVA_API_KEY=
OPENROUTER_API_KEY=
HF_API_KEY=
OPENAI_API_KEY=
DEEPAI_API_KEY=
REMOVE_BG_API_KEY=

# ---------------------------------------------------------------------
# EDBOTS REST API (control layer used by the EDBOTS App)
# ---------------------------------------------------------------------

# Master API key: full access (read, write, admin). Leave empty to use
# only per-user keys created with: node api/createKey.js <owner> [scopes]
EDBOTS_API_KEY=

# Set to "false" to run the bot without the REST API layer.
EDBOTS_API_ENABLED=true

# Port the API listens on (falls back to PORT, then 3000).
EDBOTS_API_PORT=3000

# Bind address. Use 127.0.0.1 to keep the API local-only, or 0.0.0.0 in
# containers/platform hosting.
EDBOTS_API_HOST=0.0.0.0

# Comma-separated list of browser origins allowed by CORS (the EDBOTS App
# origin). Use * only for local development.
EDBOTS_API_CORS_ORIGINS=*

# Rate limiting: max requests per key/IP per window.
EDBOTS_API_RATE_LIMIT=120

# Rate limit window in milliseconds.
EDBOTS_API_RATE_WINDOW_MS=60000

# Maximum JSON request body size in bytes.
EDBOTS_API_MAX_BODY=1048576

# ---------------------------------------------------------------------
# EDBOTS App integration (Appwrite) — planned frontend
# ---------------------------------------------------------------------

# Appwrite endpoint and project are public identifiers; the API key is a
# SECRET and must never be exposed in frontend code.
APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=edsystem
APPWRITE_API_KEY=

# Appwrite database identifiers used by the premium/backend integration.
APPWRITE_DATABASE_ID=
APPWRITE_COLLECTION_ID=

# ---------------------------------------------------------------------
# Optional third-party APIs
# ---------------------------------------------------------------------

# api-ninjas.com (free tier) — fun facts fallback
NINJAS_API_KEY=
# newsapi.org — news headlines
NEWS_API_KEY=

# ---------------------------------------------------------------------
# Admin & misc
# ---------------------------------------------------------------------

# Admin override password checked against the local admin.key file.
ADMIN_PASS=

# Provided by most hosting platforms automatically.
PORT=3000
