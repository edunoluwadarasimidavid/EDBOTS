# Node.js
node_modules/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
logs/
*.log

# Environment (secrets)
.env
.env.*
!.env.example
.env.local

# Session and Authentication (WhatsApp credentials — NEVER commit)
session/
session_backup_*/
auth/

# Puter AI auth token (captured via the link flow)
ai/puter_connection.json

# Database files (user data)
database/
*.db

# Config (user data, not framework)
data/config.json
data/smartAutoReply.json

# Temp files
temp/
tmp/

# Secrets
admin.key
*.key
*.pem
*.p12
*.pfx

# API keys (hashed only, but never publish)
data/apiKeys.json

# Runtime data files (regenerated on first boot; never contain code)
data/analytics.json
data/autoReplies.json
data/bizConfig.json
data/botModes.json
data/challengeData.json
data/commandFile.json
data/commandHelp.json
data/notifications.json
data/ownerMenu.json
data/triviaData.json

